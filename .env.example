# CareSync Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/caresync

# Authentication & JWT Secrets
JWT_SECRET=caresync-super-secure-jwt-secret-key-2026-production
JWT_EXPIRES_IN=7d

# Demo Mode Settings
DEMO_MODE=true
MOCK_OTP_AUTO_FILL=true
SANDBOX_PAYMENTS=true

# AI Provider Configuration (Options: deterministic | gemini)
# Never commit an actual API key to the repository.
AI_PROVIDER=deterministic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
